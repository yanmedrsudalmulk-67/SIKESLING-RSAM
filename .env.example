# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Connection string for local or hospital server PostgreSQL database (used by Prisma ORM).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sikesling_rsam?schema=public"

# DIRECT_URL: Optional direct database connection for Prisma migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sikesling_rsam?schema=public"

# SESSION_SECRET: Secret key used for signing server-side authentication sessions.
SESSION_SECRET="replace-with-secure-64-char-random-key-in-production"

# STORAGE_PRIVATE_DIR: Private directory path outside public web root for internal inspection photos & documents.
STORAGE_PRIVATE_DIR="./storage/private"

# UPLOAD_MAX_SIZE_MB: Maximum allowed file size in megabytes for photo and document uploads.
UPLOAD_MAX_SIZE_MB="5"

# NEXT_PUBLIC_APP_VERSION: Application version identifier.
NEXT_PUBLIC_APP_VERSION="1.0.0-supabase"

# NEXT_PUBLIC_SUPABASE_URL: Supabase REST v1 / Project URL for SIKESLING RSAM cloud persistence.
NEXT_PUBLIC_SUPABASE_URL="https://zwsshqpenadbpytvwkje.supabase.co/rest/v1/"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous JWT key for Supabase REST & Realtime integration.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp3c3NocXBlbmFkYnB5dHZ3a2plIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM0NzA0MDUsImV4cCI6MjEwOTA0NjQwNX0.rdRDwcEiYOnR8rXSm9ngpohZqOXrYu0-nNRPKjNjcsg"


